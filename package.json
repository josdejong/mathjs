{
  "name": "mathjs-website",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/josdejong/mathjs.git"
  },
  "dependencies": {
    "mathjs": "15.2.0"
  },
  "devDependencies": {
    "fancy-log": "2.0.0",
    "glob": "13.0.6",
    "gulp": "5.0.1",
    "gulp-header": "2.0.12",
    "gulp-rename": "2.1.0",
    "gulp-replace": "1.1.4",
    "handlebars": "4.7.9",
    "rimraf": "6.1.3"
  },
  "scripts": {
    "update:mathjs-src": "git submodule init && git submodule update && cd mathjs-src && git checkout master && git pull && npm install && npm run build ; cd ..",
    "build": "npm run update:mathjs-src && gulp"
  }
}
